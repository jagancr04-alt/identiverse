generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  ADMIN
  EDITOR
}
model Admin {
  id String @id @default(cuid())
  externalId String @unique
  name String
  role Role @default(EDITOR)
  active Boolean @default(true)
  createdAt DateTime @default(now())
}
model Settings {
  id String @id @default("site")
  data Json
  updatedAt DateTime @updatedAt
}
model Page {
  id String @id @default(cuid())
  slug String @unique
  group String
  title String
  description String
  published Boolean @default(false)
  data Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@index([group, published])
}
model Inquiry {
  id String @id @default(cuid())
  name String
  email String
  company String
  service String
  message String
  consentAt DateTime @default(now())
  status String @default("NEW")
  emailStatus String @default("PENDING")
  createdAt DateTime @default(now())
}
model Audit {
  id String @id @default(cuid())
  actor String
  action String
  target String
  createdAt DateTime @default(now())
}
model Media {
  id String @id @default(cuid())
  url String
  name String
  type String
  createdAt DateTime @default(now())
}
model RateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
